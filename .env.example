# Render will provide DATABASE_URL when using the included render.yaml.
DATABASE_URL=postgresql://user:password@host:5432/database
SESSION_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:10000

# Flutterwave
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx
FLW_WEBHOOK_SECRET=replace-with-your-webhook-secret

# Use true for Flutterwave sandbox/test mode.
FLW_TEST_MODE=true
